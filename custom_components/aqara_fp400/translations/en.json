{
  "config": {
    "step": {
      "user": {
        "description": "Adds zones, live target positions and setup commands for every Aqara FP400 known to the Matter integration."
      }
    },
    "abort": {
      "matter_not_loaded": "The Matter integration must be set up first.",
      "single_instance_allowed": "Already configured."
    }
  },
  "entity": {
    "sensor": {
      "zones": {
        "name": "Zones"
      },
      "targets": {
        "name": "Tracked people"
      },
      "target_x": {
        "name": "Target {index} x"
      },
      "target_y": {
        "name": "Target {index} y"
      },
      "last_motion": {
        "name": "Last motion",
        "state": {
          "enter": "Enter",
          "left": "Left",
          "left_in": "Left in",
          "right_out": "Right out",
          "right_in": "Right in",
          "left_out": "Left out",
          "access": "Access",
          "away": "Away"
        }
      },
      "activity_state": {
        "name": "Activity state",
        "state": {
          "unknown": "Unknown",
          "active": "Active",
          "still": "Still"
        }
      },
      "human_count": {
        "name": "Human count"
      },
      "install_status": {
        "name": "Install status",
        "state": {
          "level_facing_up": "Level, facing up",
          "level_tilted_facing_up": "Level, tilted facing up",
          "level_reverse_tilted_facing_up": "Level, reverse tilted facing up",
          "side_facing_forward": "Side, facing forward",
          "side_reverse_facing_forward": "Side, reverse facing forward",
          "top_facing_down": "Top, facing down",
          "tilted_facing_down": "Tilted, facing down",
          "reverse_tilted_facing_down": "Reverse tilted, facing down",
          "invalid": "Invalid"
        }
      },
      "install_angle": {
        "name": "Install angle"
      },
      "regions": {
        "name": "Regions"
      }
    },
    "switch": {
      "live_tracking": {
        "name": "Live tracking"
      }
    },
    "button": {
      "start_learning": {
        "name": "Start background learning"
      },
      "clear_zones": {
        "name": "Clear zones"
      }
    },
    "select": {
      "install_mode": {
        "name": "Install mode",
        "state": {
          "unknown": "Unknown",
          "side_mount": "Side mount",
          "top_mount": "Top mount"
        }
      },
      "side_install": {
        "name": "Side install position",
        "state": {
          "unknown": "Unknown",
          "wall": "Wall",
          "left_corner": "Left corner",
          "right_corner": "Right corner"
        }
      },
      "coordinate_reverse": {
        "name": "Coordinate reverse",
        "state": {
          "disabled": "Disabled",
          "enabled": "Enabled",
          "auto": "Auto"
        }
      },
      "detection_direction": {
        "name": "Detection direction",
        "state": {
          "omnidirectional": "Omnidirectional",
          "left_right": "Left/right"
        }
      },
      "proximity_distance_level": {
        "name": "Proximity distance level",
        "state": {
          "far": "Far",
          "medium": "Medium",
          "near": "Near"
        }
      }
    },
    "number": {
      "install_height": {
        "name": "Install height"
      }
    }
  },
  "services": {
    "set_zones": {
      "name": "Set zones",
      "description": "Replaces all detection zones. Cells are [row, column] on the 20-row x 16-column grid (row 0 nearest the sensor, column 8 straight ahead) or a \"rows,cols\" range such as \"3-4,6-10\".",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The FP400."
        },
        "zones": {
          "name": "Zones",
          "description": "List of zones with id (1-8), cells and optional enabled flag."
        }
      }
    },
    "clear_zones": {
      "name": "Clear zones",
      "description": "Removes every zone.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The FP400."
        }
      }
    },
    "subscribe_location": {
      "name": "Subscribe to location data",
      "description": "Streams target positions for the given time; the Live tracking switch does this continuously.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The FP400."
        },
        "timeout": {
          "name": "Duration",
          "description": "Seconds, up to 3600."
        }
      }
    },
    "start_learning": {
      "name": "Start background learning",
      "description": "Starts the AI space background learning (edge and interference recognition).",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The FP400."
        }
      }
    },
    "set_region": {
      "name": "Set region",
      "description": "Set an entry/exit, interference or monitoring region to a set of grid cells.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The FP400 to configure."
        },
        "region": {
          "name": "Region",
          "description": "Which region to set."
        },
        "cells": {
          "name": "Cells",
          "description": "Cells as [[row, col], ...] or a \"rows,cols\" range like \"3-6,4-8\"."
        }
      }
    },
    "clear_region": {
      "name": "Clear region",
      "description": "Clear an entry/exit, interference or monitoring region.",
      "fields": {
        "device_id": {
          "name": "Device",
          "description": "The FP400 to configure."
        },
        "region": {
          "name": "Region",
          "description": "Which region to clear."
        }
      }
    }
  }
}
